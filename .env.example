# Where the installer reads the distribution files from. Every value is
# optional and only needed by a fork that hosts its own copies.
#
# The distfiles repository is read file-by-file from raw.githubusercontent.com
# (the only GitHub host that sends CORS headers). `manifest.json` at the root
# of that repository lists every file; `scripts/build-manifest.mjs` in
# nQuake/distfiles generates it.
VITE_DISTFILES_REPO=nQuake/distfiles
VITE_DISTFILES_REF=master

# The branch (in this repository) that the `mirror-upstream` workflow
# force-pushes the latest ezQuake / MVDSV / KTX release binaries to.
VITE_UPSTREAM_REPO=nQuake/web-installer
VITE_UPSTREAM_REF=upstream-mirror

# Point the two index files somewhere else without changing where the files
# come from — e.g. a local copy of manifest.json while developing. The
# screenshot harness sets these itself.
VITE_MANIFEST_URL=
VITE_UPSTREAM_URL=
